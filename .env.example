# ─── 데이터 소스 ─────────────────────────────────────────────
# 값이 없으면 앱은 자동으로 src/lib/seed 의 시드 데이터로 동작합니다(개발/데모용).
# 실제 운영 시 아래를 채우고 DATA_SOURCE=db 로 전환하세요.
DATA_SOURCE=seed            # seed | db

# PostgreSQL (Supabase / Neon 등)
DATABASE_URL=postgres://user:pass@host:5432/shareinfo

# ─── 쿠팡 파트너스 Open API ──────────────────────────────────
# https://partners.coupang.com → 내 계정 → OpenAPI 키 발급
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUBID=shareinfo     # 트래킹용 서브아이디
COUPANG_BEST_LIMIT=50       # 카테고리별 베스트 수집 개수(최대 100) × 15개 카테고리
COUPANG_SEARCH_PER_RUN=10   # 하루에 돌릴 검색 키워드 수 (src/lib/sync/keywords.ts 순환)

# ─── 수집 후 캐시 갱신 인증 ──────────────────────────────────
# 수집 스크립트(GitHub Actions)가 /api/revalidate 를 호출할 때 쓰는 비밀키
CRON_SECRET=change-me

# ─── 사이트 ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://shareinfo.co.kr
